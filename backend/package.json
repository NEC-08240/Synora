{
  "name": "synora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synora V1 API - Node.js + Express + Microsoft SQL Server",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:test": "node --env-file=.env.test scripts/seed.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.14",
    "ws": "^8.22.2"
  }
}

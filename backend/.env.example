# Copy to .env (development) and .env.test (tests). Never commit real values.
NODE_ENV=development
PORT=4000
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SynoraV1
DB_USER=synora_app
DB_PASSWORD=change-me
# dev only: trust the local SQL Server's self-signed certificate. Startup fails if this is true in production.
DB_TRUST_SERVER_CERT=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Comma-separated origins allowed to call the API with cookies (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Secure flag on the session cookie. Always on in production; set true when served over HTTPS.
# COOKIE_SECURE=false
# Number of reverse proxies in front of the API (e.g. 1), so rate limits and lockouts see the client IP.
# Without it, every client behind a proxy shares one IP. Leave unset in development.
# Required when NODE_ENV=production (startup fails without it); use 0 if there is no proxy.
# TRUST_PROXY=1
# Requests per minute per user: shared code+SQL execute bucket, and AI session creation.
# RATE_LIMIT_EXECUTE_PER_MIN=30
# RATE_LIMIT_AI_PER_MIN=10
# Gemini Multimodal Live API (AI tutor). Leave empty to run without the AI tutor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-live-001
# Practical learning. EXECUTOR_URL = Piston-compatible code runner (e.g. http://localhost:2000). Empty = unavailable.
EXECUTOR_URL=
# Student SQL sandbox: a SEPARATE database with its own low-privilege login. Empty SANDBOX_DB_NAME = unavailable.
SANDBOX_DB_NAME=
SANDBOX_DB_USER=
# Must equal the password passed to database/sandbox_setup.sql via `sqlcmd -v SANDBOX_PASSWORD=...` (no password is stored in the script).
SANDBOX_DB_PASSWORD=
# Sandbox concurrency (parallel runs; 1 = one at a time) and how many may wait before a 429
# SANDBOX_CONCURRENCY=1
# SANDBOX_QUEUE_MAX=8
# Values above 1 are unsafe (shared sbx schema); the server refuses to start unless this is also set to 1.
# SANDBOX_ALLOW_PARALLEL=
# Set to 1 in CI: missing sandbox lab env / sqlcmd / Windows auth then FAILS the tests instead of skipping them
# REQUIRE_SANDBOX_TESTS=1
# Per-IP login attempts per minute (separate from the failed-sign-in lockout)
# RATE_LIMIT_LOGIN_PER_MIN=20
# RATE_LIMIT_SUBMIT_PER_MIN=
# ASSESSMENT_GRADE_CONCURRENCY=
# ASSESSMENT_QUEUE_MAX=
# Optional overrides (leave commented unless needed; an empty value is not the same as unset)
# SANDBOX_DB_SERVER=
# SANDBOX_DB_PORT=
# EXECUTOR_RUN_TIMEOUT_MS=
# EXECUTOR_COMPILE_TIMEOUT_MS=
# Demo-account password for `npm run seed` / `npm run seed:test`. Required, minimum 12 characters, no default.
SEED_PASSWORD=
# Seeding refuses to run unless ALLOW_SEED=1 (and NODE_ENV is not production). Only for a disposable database.
# ALLOW_SEED=1
# ALLOW_SEED=1 is a deliberate opt-in: `npm run seed` (.env) is not covered by the test-database guard and writes to DB_NAME. NODE_ENV=production is always refused.

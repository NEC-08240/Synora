# Copy to .env (development) and .env.test (tests). Never commit real values.
PORT=4000
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SynoraV1
DB_USER=synora_app
DB_PASSWORD=change-me
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Gemini Multimodal Live API (AI tutor). Leave empty to run without the AI tutor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-live-001
# Practical learning. EXECUTOR_URL = Piston-compatible code runner (e.g. http://localhost:2000). Empty = unavailable.
EXECUTOR_URL=
# Student SQL sandbox: a SEPARATE database with its own low-privilege login. Empty SANDBOX_DB_NAME = unavailable.
SANDBOX_DB_NAME=
SANDBOX_DB_USER=
SANDBOX_DB_PASSWORD=
# Sandbox concurrency (parallel runs; 1 = one at a time) and how many may wait before a 429
# SANDBOX_CONCURRENCY=1
# SANDBOX_QUEUE_MAX=8
# Values above 1 are unsafe (shared sbx schema); the server refuses to start unless this is also set to 1.
# SANDBOX_ALLOW_PARALLEL=
# Set to 1 in CI: missing sandbox lab env / sqlcmd / Windows auth then FAILS the tests instead of skipping them
# REQUIRE_SANDBOX_TESTS=1
# Per-IP login attempts per minute (separate from the failed-sign-in lockout)
# RATE_LIMIT_LOGIN_PER_MIN=20
# Optional overrides (leave commented unless needed; an empty value is not the same as unset)
# SANDBOX_DB_SERVER=
# SANDBOX_DB_PORT=
# EXECUTOR_RUN_TIMEOUT_MS=
# EXECUTOR_COMPILE_TIMEOUT_MS=
# Password used by seed.js and the tests for the demo accounts
# SEED_PASSWORD=

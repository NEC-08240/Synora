# Copy to /etc/synora-gateway/gateway.env, chmod 600, owner root. Never commit the real file.
SYNORA_GATEWAY_HOST=127.0.0.1
SYNORA_GATEWAY_PORT=8000
# Generate with: openssl rand -base64 48   (the Gateway refuses secrets shorter than 32 bytes)
SYNORA_GATEWAY_SIGNING_SECRET=REPLACE_ME
SYNORA_GATEWAY_REGISTRY_PATH=/etc/synora-gateway/team.json
SYNORA_GATEWAY_WORKER_REGISTRY_PATH=/etc/synora-gateway/workers.json
SYNORA_GATEWAY_DB_PATH=/var/lib/synora-gateway/gateway.db
SYNORA_GATEWAY_AUDIT_LOG_PATH=/var/log/synora-gateway/audit.log
SYNORA_GATEWAY_RECOVERY_INTERVAL=30

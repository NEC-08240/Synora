# Copy to %USERPROFILE%\.synora\worker.env and edit. Paths and names only: never put a key's contents here.
# Only lines named SYNORA_* are read. No quotes around values.
SYNORA_PYTHON=C:\Python314\python.exe
# The checkout the Worker runs from and creates job worktrees in. Keep it on a stable branch/commit:
# whatever is checked out here is the code the Worker runs at its next restart.
SYNORA_BRIDGE_REPO=C:\path\to\Synora-checkout
SYNORA_WORKER_ID=worker-johan
# wss:// only. The pinned certificate is required for a self-signed Gateway.
SYNORA_GATEWAY_URL=wss://<ELASTIC_IP>
SYNORA_CA_CERT=C:\Users\YOU\.synora\gateway.crt
# Raw 32-byte private key file created by `admin_cli keygen` (never commit or share it).
SYNORA_WORKER_KEY_FILE=C:\Users\YOU\.synora\keys\worker-johan.key
# Where the daemon writes its timestamped log (rotated at 5 MB, 3 backups).
SYNORA_WORKER_LOG_FILE=C:\Users\YOU\.synora\logs\worker.log
# Optional local limits (defaults: 10 jobs/hour, 50/day, 2048 MB, 2 worktrees):
# SYNORA_WORKER_JOBS_PER_HOUR=10
# SYNORA_WORKER_JOBS_PER_DAY=50
